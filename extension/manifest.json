{
  "manifest_version": 3,
  "name": "TV Futures Bridge",
  "version": "0.4.0",
  "description": "TradingView chart visual signal reader with Binance USD-M Futures Demo/Live trading, small USDT size, manual tests and order reconciliation.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://demo-fapi.binance.com/*",
    "https://fapi.binance.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TradingView Futures Bridge",
    "default_popup": "popup.html"
  }
}
